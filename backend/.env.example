PORT=4000
DATABASE_URL="postgresql://electronica:electronica@localhost:5434/electronica?schema=public"

# Минимум 32 символа. Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Админ, которого создаёт `npm run db:seed`
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="admin12345"

# false — сид создаёт только админа, без демо-каталога (боевой сервер)
# SEED_DEMO=false

# Каталог для загруженных фото (по умолчанию ./uploads)
# UPLOAD_DIR=/var/lib/electronica/uploads

# За nginx/балансировщиком: число прокси или true
# TRUST_PROXY=1

# Адрес фронтенда для CORS (через запятую, если несколько)
CORS_ORIGIN="http://localhost:3000"
