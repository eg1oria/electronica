generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
}

model User {
  id           Int      @id @default(autoincrement())
  login        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(MANAGER)
  /// Увеличивается при смене пароля/роли — старые JWT становятся недействительными.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    Int?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  logo        String?
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               Int            @id @default(autoincrement())
  name             String
  slug             String         @unique
  sku              String         @unique
  shortDescription String?
  description      String         @db.Text
  price            Decimal        @db.Decimal(12, 2)
  oldPrice         Decimal?       @db.Decimal(12, 2)
  stock            Int            @default(0)
  isActive         Boolean        @default(true)
  isFeatured       Boolean        @default(false)
  warrantyMonths   Int?
  weightGrams      Int?
  categoryId       Int
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId          Int?
  brand            Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  specs            ProductSpec[]
  banners          Banner[]
  orderItems       OrderItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([price])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  alt       String?
  position  Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSpec {
  id        Int     @id @default(autoincrement())
  name      String
  value     String
  group     String?
  position  Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Слайд промо-блока на главной (не больше 5).
model Banner {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Пусто — «Хит продаж»
  badge     String?
  /// Пусто — название товара
  title     String?
  /// Пусто — краткое описание товара
  subtitle  String?
  /// Пусто — главное фото товара
  image     String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum DeliveryMethod {
  COURIER
  PICKUP
}

enum PaymentMethod {
  ON_DELIVERY
  INSTALLMENT
}

/// Заказ с витрины. Цены и сумма фиксируются на момент оформления.
model Order {
  id           Int            @id @default(autoincrement())
  status       OrderStatus    @default(NEW)
  customerName String
  phone        String
  email        String?
  delivery     DeliveryMethod
  city         String?
  address      String?
  apartment    String?
  payment      PaymentMethod
  comment      String?
  total        Decimal        @db.Decimal(12, 2)
  items        OrderItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Позиция заказа — снимок товара, чтобы заказ не менялся при правке каталога.
model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Пусто — товар удалён из каталога
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  sku       String
  price     Decimal  @db.Decimal(12, 2)
  qty       Int

  @@index([orderId])
  @@index([productId])
}
