generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(MANAGER)
  /// Увеличивается при смене пароля/роли — старые JWT становятся недействительными.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    Int?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  logo        String?
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               Int            @id @default(autoincrement())
  name             String
  slug             String         @unique
  sku              String         @unique
  shortDescription String?
  description      String         @db.Text
  price            Decimal        @db.Decimal(12, 2)
  oldPrice         Decimal?       @db.Decimal(12, 2)
  stock            Int            @default(0)
  isActive         Boolean        @default(true)
  isFeatured       Boolean        @default(false)
  warrantyMonths   Int?
  weightGrams      Int?
  categoryId       Int
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId          Int?
  brand            Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  specs            ProductSpec[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([price])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  alt       String?
  position  Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSpec {
  id        Int     @id @default(autoincrement())
  name      String
  value     String
  group     String?
  position  Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}
