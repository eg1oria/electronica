# Настройки продакшн-стека (docker compose в корне репозитория).
# Скопируйте в .env и заполните. Файл .env в git не попадает.

# ---------- домен ----------
# Публичный адрес сайта: нужен API для CORS и в письмах/ссылках.
SITE_URL=https://example.com

# Порты, которые nginx занимает на сервере.
HTTP_PORT=80
HTTPS_PORT=443

# ---------- база данных ----------
POSTGRES_USER=electronica
POSTGRES_DB=electronica
# Обязательно. Сгенерировать: openssl rand -base64 24
POSTGRES_PASSWORD=

# ---------- API ----------
# Обязательно, минимум 32 символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Первый администратор — создаётся командой `docker compose exec api node dist/seed.js`.
ADMIN_LOGIN=admin
# Минимум 8 символов. Смените пароль в админке после первого входа.
ADMIN_PASSWORD=

# true — вместе с админом создать демо-каталог (товары, бренды, категории).
SEED_DEMO=false

# Сколько прокси стоит перед API (nginx из этого же compose — 1).
TRUST_PROXY=1

# ---------- витрина ----------
# Адрес API для браузера. «/api» — сайт и API на одном домене через nginx.
# Значение вшивается в сборку: после изменения нужен `docker compose build web`.
NEXT_PUBLIC_API_URL=/api
