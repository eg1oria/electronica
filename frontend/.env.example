# Публичный адрес API для браузера (отсюда берутся фото /uploads/...).
# Значение вшивается в сборку. Относительный «/api» — API на том же домене
# (за nginx), абсолютный URL — API на отдельном порту или домене.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Внутренний адрес API для серверного рендеринга, если отличается.
# В Docker-стеке: API_URL=http://api:4000/api
# API_URL=
